{
    "$schema": "https://www.schemastore.org/package.json",
    "version": "2.19.1",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "test": "LARAVEL_BYPASS_ENV_CHECK=1 vitest run --coverage",
        "lint": "eslint resources/js",
        "lint:fix": "eslint resources/js --fix",
        "format": "docker-compose exec app ./vendor/bin/pint",
        "phpstan": "docker-compose exec app ./vendor/bin/phpstan analyze app --level=8 --memory-limit=-1",
        "test:e2e": "npx playwright test --reporter=list",
        "test:e2e:ui": "npx playwright test --ui",
        "test:e2e:report": "npx playwright show-report"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vitest/coverage-v8": "^5.0.5",
        "@vue/test-utils": "^2.5.1",
        "concurrently": "^10.0.6",
        "eslint": "^10.13.0",
        "eslint-plugin-vue": "^10.11.1",
        "globals": "^17.13.0",
        "jsdom": "^30.1.3",
        "laravel-vite-plugin": "^3.2",
        "tailwindcss": "^4.0.0",
        "vite": "^8.3.5",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^5.0.0"
    },
    "dependencies": {
        "axios": "^1.20.0",
        "pinia": "^3.0.4",
        "vue": "^3.5.44",
        "vue-i18n": "^11.4.16",
        "vue-router": "^4.6.4"
    }
}
